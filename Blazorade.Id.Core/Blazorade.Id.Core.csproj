<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<Title>Blazorade ID Core</Title>
		<Version>2.0.0</Version>
		<Authors>Mika Berglund</Authors>
		<Company>Blazorade</Company>
		<Product>Blazorade ID Core</Product>
		<Description>Blazorade ID Core contains the core functionality for Blazorade ID, and is shared across different application types.</Description>
		<Copyright>Copyright (c) Mika Berglund 2024</Copyright>
		<PackageProjectUrl>https://github.com/Blazorade/Blazorade-Id</PackageProjectUrl>
		<PackageIcon>Blazorade-Id-Logo-128.png</PackageIcon>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/Blazorade/Blazorade-Id</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;Authentication:OIDC</PackageTags>
		<PackageReleaseNotes>For details about this release, check out the release notes on Nuget at https://www.nuget.org/packages/Blazorade.Id.Core.</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<RootNamespace>Blazorade.Id</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Microsoft.Extensions.Options" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Blazorade-Id-Logo-128.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Update="readme.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
